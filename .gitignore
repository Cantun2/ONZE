# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Secrets / env ---
.env
.env.*
!.env.example

# --- Data (raw datasets are downloaded, not versioned) ---
data/raw/*
!data/raw/.gitkeep
# processed artifacts (parquet / duckdb) are regenerated by the pipeline
data/processed/*
!data/processed/.gitkeep

# --- Node / frontend ---
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-error.log*

# --- Notebooks / reports scratch ---
.ipynb_checkpoints/
reports/*
!reports/.gitkeep

# --- OS / editor ---
.DS_Store
.idea/
.vscode/
*.swp
