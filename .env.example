# ONZE environment variables. Copy to .env and fill in.
# .env is git-ignored — never commit real keys.

# The Odds API key for live bookmaker odds (spec §2.1, src/ingest/odds.py).
# Get one at https://the-odds-api.com/ . Required only for live-odds ingestion;
# the historical backtest pipeline runs without it.
ONZE_ODDS_API_KEY=

# Base URL the frontend uses to reach the API (used by docker-compose).
VITE_API_BASE_URL=http://localhost:8000
